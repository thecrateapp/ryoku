#!/usr/bin/env bash
# Adjust the output that holds keyboard focus when this keypress arrives.
set -euo pipefail

if [[ $# != 1 || ! $1 =~ ^[+-][0-9]+$ ]]; then
  echo 'usage: ryoku-cmd-brightness <+N|-N>' >&2
  exit 2
fi

output=$(RYOKU_WM_CALL_TIMEOUT="${RYOKU_WM_CALL_TIMEOUT:-1s}" ryoku wm state |
  jq -er '.focusedOutput | strings | select(length > 0)')
percent=$(ryoku-brightness-output adjust "$output" "$1")
# The brightness keys also work while the presentation shell is unavailable.
timeout 1s qs -c shell ipc call -- brightnessOsd show "$output" "$percent" >/dev/null 2>&1 || true
