#!/bin/bash
set -euo pipefail

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
root=${OMARCHY_PATH:-$data_home/ryoku/nomarchy}
local_bin=${XDG_BIN_HOME:-$HOME/.local/bin}
check=0
[[ ${1:-} == --check ]] && check=1

for link in "$local_bin"/omarchy "$local_bin"/omarchy-*; do
  [[ -L $link ]] || continue
  target=$(readlink -- "$link")
  [[ $target == "$root/bin/"* ]] || continue
  if (( check )); then
    exit 1
  fi
  rm -f -- "$link"
done

# The theme nomarchy rendered into Omarchy's state goes with its commands:
# apps that follow Omarchy (ZapFast and other fastframe apps) take
# ~/.config/omarchy plus this folder for a running Omarchy, then call the
# omarchy-* commands removed above. nomarchy-activate renders it again. Only
# nomarchy's own: a real Omarchy install ($data_home/omarchy) keeps its theme.
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
current=$state_home/omarchy/current
if [[ -d $root && ! -d $data_home/omarchy && ( -e $current || -L $current ) ]]; then
  (( check )) && exit 1
  rm -rf -- "$current"
fi

(( check )) && exit 0
exit 0
